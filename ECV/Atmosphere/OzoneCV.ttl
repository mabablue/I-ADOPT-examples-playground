@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix actris_vocab: <https://vocabulary.actris.nilu.no/actris_vocab/> .
@prefix ns0: <https://w3id.org/iadopt/ont/> .
@prefix dc: <http://purl.org/dc/terms/> .

ex:O3
    a 
        iop:Variable ;
    rdfs:label 
        "Ozone total column molecular content " ;
    rdfs:comment 
        """2D field of total amount of O3 molecules per unit area in an atmospheric column extending from the Earth’s surface to the upper edge of the atmosphere.""" ;
    iop:hasObjectOfInterest 
        <http://vocab.nerc.ac.uk/collection/S27/current/CS003171/> ;
    iop:hasMatrix 
        <http://vocab.nerc.ac.uk/collection/S21/current/S21S001/> ;
    iop:hasProperty 
        actris_vocab:columnmolecularcontent ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "spatial: total" ;
             iop:constrains actris_vocab:columnmolecularcontent ;
        ] .

<http://vocab.nerc.ac.uk/collection/S27/current/CS003171/>
    a 
        iop:Entity ;
    rdfs:label 
        "ozone" .

<http://vocab.nerc.ac.uk/collection/S21/current/S21S001/>
    a 
        iop:Entity ;
    rdfs:label 
        "atmosphere" .

actris_vocab:columnmolecularcontent
    a 
        iop:Property ;
    rdfs:label 
        "column molecular content" .
