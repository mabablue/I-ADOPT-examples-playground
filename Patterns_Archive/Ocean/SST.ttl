<http://example.org/Temperature>
    a 
        iop:Variable ;
    rdfs:label 
        "Sea surface temperature" ;
    rdfs:comment 
        """Radiative skin sea surface temperature, given in K.""" ;
    iop:hasObjectOfInterest 
        <http://vocabs.lter-europe.net/EnvThes/22225> ;
    iop:hasContextObject 
        <https://www.wikidata.org/entity/Q117750525> ;
    iop:hasProperty 
        <http://qudt.org/vocab/quantitykind/ThermodynamicTemperature> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "part: surface" ;
             iop:constrains <http://vocabs.lter-europe.net/EnvThes/22225> ;
        ] .

<http://vocabs.lter-europe.net/EnvThes/22225>
    a 
        iop:Entity ;
    rdfs:label 
        "water" .

<http://qudt.org/vocab/quantitykind/ThermodynamicTemperature>
    a 
        iop:Property ;
    rdfs:label 
        "thermodynamic temperature" .

<https://www.wikidata.org/entity/Q117750525>
    a 
        iop:Entity ;
    rdfs:label 
        "marine environment" .
