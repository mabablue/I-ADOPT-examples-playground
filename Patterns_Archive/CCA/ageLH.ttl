<http://example.org/CCA/ageLH>
    a 
        iop:Variable ;
    rdfs:label 
        "Idealised_age_tracer_LaHage" ;
    rdfs:comment 
        """Idealized age tracer with linearly increased discharge of atoms from La Hage, France.  The release rate starts at 1.00E+20 atoms per second discharge in 1946, increasing by 1.00E+20 atoms per year, and reaches 7.30E+21 in 2018 at the end of simulation expressed in atoms per kg.""" ;
